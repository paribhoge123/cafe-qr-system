# ─── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/cafe_qr_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafe_qr_db
DB_USER=postgres
DB_PASSWORD=password

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another_long_random_secret_for_refresh
JWT_REFRESH_EXPIRES_IN=30d

# ─── QR Code signing ──────────────────────────────────
QR_HMAC_SECRET=yet_another_long_secret_for_qr_tokens
QR_TOKEN_EXPIRY_HOURS=24

# ─── OTP ──────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
# MSG91_API_KEY=your_msg91_key
# MSG91_SENDER_ID=CAFEQR
# MSG91_TEMPLATE_ID=your_template_id

# ─── Razorpay ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── File Storage (S3 / Cloudflare R2) ────────────────
STORAGE_ENDPOINT=https://your-r2-account.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_BUCKET=cafe-qr-assets
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=https://assets.yourcafe.com

# ─── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
